# Copia este archivo a .env (no se versiona) y rellena los valores.

# Modo de integracion con AWS: mock | real
RELEASY_AWS_MODE=mock

# Usuario administrador del portal (Spring Security basico)
RELEASY_ADMIN_USER=admin
RELEASY_ADMIN_PASSWORD=cambia-esta-clave

# Secreto con el que se firman los JWT de sesion (minimo 32 caracteres). Genera uno con:
#   openssl rand -base64 48
RELEASY_JWT_SECRET=cambia-este-secreto-por-uno-aleatorio-de-32-o-mas

# Cuenta AWS de la plataforma (en ella confia el rol ReleEasyDeployRole de cada cliente)
RELEASY_PLATFORM_ACCOUNT_ID=000000000000

# URL publica de la plantilla del rol del cliente (salida role_template_url de deploy/platform).
# Vacia: el portal deshabilita el enlace Quick-create.
RELEASY_AWS_ROLE_TEMPLATE_URL=

# GitHub: mock (repositorios ficticios) | real (GitHub App de ReleEasy; ver backend/docs/github-app.md)
RELEASY_GITHUB_MODE=mock
# Solo en modo real. La clave .pem va FUERA del repositorio (p. ej. ~/.releasy/github-app.pem).
RELEASY_GITHUB_APP_ID=
RELEASY_GITHUB_PRIVATE_KEY_PATH=
RELEASY_GITHUB_CLIENT_ID=
RELEASY_GITHUB_CLIENT_SECRET=

# Secreto compartido con el webhook de GitHub (en AWS se inyecta desde Secrets Manager)
RELEASY_GITHUB_WEBHOOK_SECRET=cambia-este-secreto

# --- AWS real (solo si RELEASY_AWS_MODE=real) ---
# Valores de la plataforma que cada persona despliega con backend/deploy/platform (terraform output).
AWS_REGION=us-east-1
# RELEASY_PLATFORM_ACCOUNT_ID ya esta mas arriba; pon el ID de TU cuenta
RELEASY_STATE_MACHINE_ARN=arn:aws:states:us-east-1:<ID_CUENTA>:stateMachine:releasy-deploy
# Output role_template_url de platform/ (plantilla del rol publicada en S3)
RELEASY_ROLE_TEMPLATE_URL=https://releasy-public-<ID_CUENTA>.s3.us-east-1.amazonaws.com/cloudformation/releasy-deploy-role.yaml
# Perfil de la CLI de AWS con tus credenciales (nunca pongas claves en este archivo)
AWS_PROFILE=
